# ==============================================================================
# 🛡️ CyberTriage AI - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and insert your desired API key:
#   cp .env.example .env
# ==============================================================================

# Option 1: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Option 2: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 3: Anthropic
ANTHROPIC_API_KEY=

# Option 4: Local Ollama
USE_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Server Settings
PORT=8000
HOST=127.0.0.1
