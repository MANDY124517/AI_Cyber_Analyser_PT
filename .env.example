# ==============================================================================
# 🛡️ CyberTriage AI - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your desired local models or API providers:
#   cp .env.example .env
# ==============================================================================

# --- Option 1: Local Ollama (Recommended / Offline Production) ---
LLM_PROVIDER=ollama
USE_OLLAMA=true
OLLAMA_HOST=http://127.0.0.1:11434

# Primary Analysis Model (Options: qwen2.5:7b, CyberCrew/notmythos-8b:latest, hermes3:3b)
OLLAMA_MODEL=qwen2.5:7b

# IBM Granite Guardian 3 (8B) Safety & Grounding Interceptor
OLLAMA_GUARDIAN_MODEL=ibm/granite3-guardian:8b
ENABLE_GRANITE_GUARDIAN=true
GUARDIAN_NUM_GPU=0

# Ollama Tuning Parameters
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_REPEAT_PENALTY=1.15
OLLAMA_REPEAT_LAST_N=64
OLLAMA_TOP_K=40
OLLAMA_KEEP_ALIVE=60m
OLLAMA_CONCURRENCY=1

# --- Option 2: Cloud Providers (Optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=

# --- Server Settings ---
PORT=8000
HOST=127.0.0.1
